APP_NAME=Jobshour
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8090

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Errores servidor (opcional). Paquete sentry/sentry-laravel ya instalado; sin DSN no envía.
# SENTRY_LARAVEL_DSN=

DB_CONNECTION=pgsql
DB_HOST=jobshour-db
DB_PORT=5432
DB_DATABASE=jobshour
DB_USERNAME=jobshour
DB_PASSWORD=jobshour_secret

BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_HOST=jobshour-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@jobshour.cl"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# URL del front (Next) — enlaces en correos y back_urls de Mercado Pago
# Si APP_URL es solo la API (p. ej. https://api.jobshours.com), FRONTEND_URL debe ser la SPA.
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# Dominio principal del sitio (sin protocolo). Bloqueado para registrar como tienda; alinear con NEXT_PUBLIC_PRIMARY_HOST en Next.
# PRIMARY_PUBLIC_HOST=jobshours.com

# Correo mostrado en el cuerpo del mail al comprador (dudas / cargos no reconocidos). Opcional.
SUPPORT_EMAIL=contacto@jobshour.cl

# -----------------------------------------------------------------------------
# Correo transaccional: al pasar un pedido de TIENDA de "pending" a "paid" (webhook MP o QA)
# se envía mail al comprador (link a /tienda/success) y aviso al vendedor.
# En local MAIL_MAILER=log escribe en storage/logs; en producción usar smtp, ses, resend, etc.
# -----------------------------------------------------------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.tuproveedor.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb WebSocket
# PRODUCCIÓN: REVERB_HOST=127.0.0.1 (Supervisor + Nginx proxy)
# LOCAL/Docker: REVERB_HOST=jobshour-api o 0.0.0.0
REVERB_APP_ID=jobshour-app
REVERB_APP_KEY=jobshour-key
REVERB_APP_SECRET=jobshour-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# En Next.js (jobshour-web), NEXT_PUBLIC_REVERB_APP_KEY debe ser el mismo valor que REVERB_APP_KEY
# y NEXT_PUBLIC_REVERB_HOST el dominio público donde el navegador abre wss (p. ej. jobshours.com).

# Video Processing
FFMPEG_BINARIES=/usr/bin/ffmpeg
FFPROBE_BINARIES=/usr/bin/ffprobe
MAX_VIDEO_SIZE_MB=64
VIDEO_MAX_DURATION_SECONDS=60

# Map
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Pin morado "tienda premium" en GET /api/v1/experts/nearby: usar workers.show_premium_pin_on_map + premium_external_store_url (PUT /api/v1/worker/premium-map-pin).
# Si ningún worker tiene pin activo en radio, fallback opcional por env:
# PREMIUM_STORE_WORKER_ID=2
# PREMIUM_STORE_URL=https://dondemorales.cl
# PREMIUM_STORE_NAME=DonDeMorales
# PREMIUM_STORE_AVATAR=

# Mercado Pago (tienda y pagos por link/chat)
# Obtener en https://www.mercadopago.cl/developers/panel/app
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# true = procesar webhooks MP (pagos + tienda) en el mismo request (local sin queue worker). Producción: false.
# MP_WEBHOOK_SYNC=false
# Firma HMAC de webhooks (MP envía x-signature). En producción configurar; vacío = no validar.
# MERCADOPAGO_WEBHOOK_SECRET=

# Product analytics (POST /api/v1/analytics/events) — si se define, el cliente debe enviar X-Analytics-Secret
# ANALYTICS_INGEST_SECRET=
# Días de retención de filas (comando: php artisan analytics:prune)
# ANALYTICS_RETENTION_DAYS=365

# Integración tienda → demanda en mapa (POST /api/v1/integrations/store-demand): crear token con
#   php artisan store-demand:integration {user_id} "Nombre tienda" [--category=ID] [--ips=IP1,IP2]
# Rotar token: php artisan store-demand:integration-rotate {integration_id}
# Lista blanca IP (sin tocar token): php artisan store-demand:integration-ips {integration_id} "IP1,IP2" | --clear
# Los eventos se registran en el log estándar con clave store_demand_integration.* (publish / ip_blocked / outside_zone).
# Rate limit dedicado: partner-store-demand (60 req/min por token; AppServiceProvider).

# Panel admin API (lista de user_id separados por coma)
# ADMIN_USER_IDS=21

# Firebase / FCM (push). El JSON NO va en git: copiar desde Google Cloud IAM al servidor.
# FIREBASE_CREDENTIALS=storage/firebase/jobshours-firebase-adminsdk-fbsvc-a52be09a7f.json
# FIREBASE_WEB_API_KEY=
# Verificar: php artisan firebase:verify

# Retención FCM (cooldown entre pushes duplicados por usuario)
# RETENTION_PUSH_COOLDOWN_HOURS=24

# Google OAuth (móvil): callback debe ser un host que Cloudflare/nginx alcancen (p. ej. jobshours.com).
# GOOGLE_REDIRECT_MOBILE_URI=https://jobshours.com/api/auth/google/callback/mobile
# Tras login Google móvil, redirect del API a esta SPA (evita 522 si el subdominio no llega al VPS).
# OAUTH_MOBILE_FRONTEND_URL=https://jobshours.com

# Boost pago: demanda pendiente en mapa (Checkout Pro; precio CLP e horas por defecto)
# BOOST_DEMAND_PRICE_CLP=4990
# BOOST_DEMAND_HOURS=24

# Privacidad analytics: anonimizar IP/UA en filas antiguas (comando analytics:anonymize-pii)
# ANALYTICS_PII_ANONYMIZE_AFTER_DAYS=90

# Slack: resumen semanal de cohorte (Incoming Webhook)
# ANALYTICS_SLACK_WEBHOOK_URL=

# Telescope: en config el default es false. En local pon true si usás Telescope.
# TELESCOPE_ENABLED=true

# Geofencing zona piloto (false = mapa abierto como antes)
# GEOFENCE_ENABLED=false
# GEOFENCE_CENTER_LAT=-37.6672
# GEOFENCE_CENTER_LNG=-72.5730
# GEOFENCE_RADIUS_KM=15
# GEOFENCE_ZONE_NAME="Angol, La Araucanía"
# GEOFENCE_MAX_SEARCH_KM=25
