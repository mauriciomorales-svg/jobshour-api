<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="true"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="BROADCAST_DRIVER" value="null"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Evita MAIL_MAILER=resend del .env (falta resend/resend-php). No uses solo .env.testing con MAIL_MAILER:
             Laravel con APP_ENV=testing carga ÚNICAMENTE .env.testing y dejaría sin DB_* del .env principal. -->
        <env name="MAIL_MAILER" value="array"/>
        <!-- DB: usar el mismo .env que el proyecto (evita puerto fijo incorrecto). Para CI, definir variables en el workflow. -->
    </php>
</phpunit>
